# Cravora environment variables. Copy to .env.local for development.
# All three are PUBLIC values (safe in the browser bundle). No service-role / secret key is used,
# and no payment or notification provider is integrated (so none of their keys are needed).

# Supabase project URL.
#   Local:  API_URL from `npx supabase status` (http://127.0.0.1:56321 with this repo's config)
#   Hosted: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_…). The legacy anon key also works via
# NEXT_PUBLIC_SUPABASE_ANON_KEY.
#   Local:  PUBLISHABLE_KEY from `npx supabase status`
#   Hosted: Dashboard → Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute site URL used in auth emails (confirm sign-up, reset password).
# Must be listed in Supabase Auth → URL configuration → Redirect URLs.
#   Local: http://localhost:3002   Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3002
